{
  "name": "agentic-chat-completion",
  "version": "0.0.39",
  "attributes": {
    "Provider": "Dataloop",
    "Category": "Model",
    "NLP": "Conversational",
    "Gen AI": "LMM",
    "Media Type": [
      "Text"
    ],
    "Deployed By": "Dataloop"
  },
  "displayName": "Agentic Chat Completion",
  "description": "Agentic chat completion with tool-calling loop via Jarvis MCP",
  "scope": "public",
  "codebase": {
    "type": "git",
    "gitUrl": "https://github.com/dataloop-ai-apps/openai-model-adapters.git",
    "gitTag": "0.0.39"
  },
  "components": {
    "computeConfigs": [
      {
        "name": "agent-deploy",
        "runtime": {
          "podType": "regular-xs",
          "concurrency": 1,
          "autoscaler": {
            "type": "rabbitmq",
            "minReplicas": 0,
            "maxReplicas": 2,
            "queueLength": 100
          },
          "runnerImage": "gcr.io/viewo-g/piper/agent/runner/apps/openai-model-adapters:0.0.14"
        }
      }
    ],
    "modules": [
      {
        "name": "agent-module",
        "entryPoint": "adapters/agentic_chat_completion/agentic_chat_completion.py",
        "className": "AgenticChatCompletion",
        "computeConfig": "agent-deploy",
        "description": "Agentic model adapter with tool-calling loop via Jarvis MCP",
        "initInputs": [
          {
            "type": "Model",
            "name": "model_entity"
          }
        ],
        "functions": [
          {
            "name": "evaluate_model",
            "input": [
              {
                "type": "Model",
                "name": "model",
                "description": "Dataloop Model Entity"
              },
              {
                "type": "Dataset",
                "name": "dataset",
                "description": "Dataloop Dataset Entity"
              },
              {
                "type": "Json",
                "name": "filters",
                "description": "Dataloop Filter DQL"
              }
            ],
            "output": [
              {
                "type": "Model",
                "name": "model",
                "description": "Dataloop Model Entity"
              },
              {
                "type": "Dataset",
                "name": "dataset",
                "description": "Dataloop Dataset Entity"
              }
            ],
            "displayName": "Evaluate a Model",
            "displayIcon": "",
            "description": "Evaluate agent model performance"
          },
          {
            "name": "predict_items",
            "input": [
              {
                "type": "Item[]",
                "name": "items",
                "description": "List of items to run inference on"
              }
            ],
            "output": [
              {
                "type": "Item[]",
                "name": "items",
                "description": "The same input items."
              },
              {
                "type": "Annotation[]",
                "name": "annotations",
                "description": "The predicted annotations."
              }
            ],
            "displayName": "Predict Items",
            "displayIcon": "",
            "description": "Run agentic tool-calling loop"
          },
          {
            "name": "predict_dataset",
            "input": [
              {
                "type": "Dataset",
                "name": "dataset",
                "description": "Dataloop Dataset Entity"
              },
              {
                "type": "Json",
                "name": "filters",
                "description": "Dataloop Filter DQL"
              }
            ],
            "output": [],
            "displayName": "Predict Dataset",
            "displayIcon": "",
            "description": "Run agentic loop on a dataset"
          }
        ]
      }
    ],
    "models": [
      {
        "name": "custom-agent",
        "moduleName": "agent-module",
        "scope": "project",
        "status": "pre-trained",
        "configuration": {
          "model_name": "openai/gpt-4o",
          "llm_type": "Agent",
          "system_prompt": "You are a helpful assistant. Use the available tools to assist the user.",
          "tool_set_id": "",
          "max_turns": 20,
          "max_tokens": 4096,
          "temperature": 0.2,
          "stream": false
        },
        "description": "Custom agent model for tool-calling and agentic workflows."
      }
    ]
  }
}
