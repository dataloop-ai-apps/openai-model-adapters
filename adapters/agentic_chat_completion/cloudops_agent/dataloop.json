{
  "name": "cloudops-agent",
  "version": "0.0.39",
  "attributes": {
    "Provider": "Dataloop",
    "Category": "Model",
    "NLP": "Conversational",
    "Gen AI": "LMM",
    "Media Type": [
      "Text"
    ],
    "Deployed By": "Dataloop"
  },
  "displayName": "CloudOps Agent",
  "description": "Cloud operations agents for cost optimization, resource health monitoring, compliance auditing, and orphan resource detection. Powered by Jarvis LLM and MCP tool sets.",
  "scope": "public",
  "codebase": {
    "type": "git",
    "gitUrl": "https://github.com/dataloop-ai-apps/openai-model-adapters.git",
    "gitTag": "0.0.39"
  },
  "components": {
    "computeConfigs": [
      {
        "name": "cloudops-agent-deploy",
        "runtime": {
          "podType": "regular-xs",
          "concurrency": 1,
          "autoscaler": {
            "type": "rabbitmq",
            "minReplicas": 0,
            "maxReplicas": 2,
            "queueLength": 100
          },
          "runnerImage": "gcr.io/viewo-g/piper/agent/runner/apps/openai-model-adapters:0.0.14"
        }
      }
    ],
    "modules": [
      {
        "name": "cloudops-agent-module",
        "entryPoint": "adapters/agentic_chat_completion/agentic_chat_completion.py",
        "className": "AgenticChatCompletion",
        "computeConfig": "cloudops-agent-deploy",
        "description": "Agentic model adapter with tool-calling loop via Jarvis MCP",
        "initInputs": [
          {
            "type": "Model",
            "name": "model_entity"
          }
        ],
        "functions": [
          {
            "name": "evaluate_model",
            "input": [
              {
                "type": "Model",
                "name": "model",
                "description": "Dataloop Model Entity"
              },
              {
                "type": "Dataset",
                "name": "dataset",
                "description": "Dataloop Dataset Entity"
              },
              {
                "type": "Json",
                "name": "filters",
                "description": "Dataloop Filter DQL"
              }
            ],
            "output": [
              {
                "type": "Model",
                "name": "model",
                "description": "Dataloop Model Entity"
              },
              {
                "type": "Dataset",
                "name": "dataset",
                "description": "Dataloop Dataset Entity"
              }
            ],
            "displayName": "Evaluate a Model",
            "displayIcon": "",
            "description": "Evaluate agent model performance"
          },
          {
            "name": "predict_items",
            "input": [
              {
                "type": "Item[]",
                "name": "items",
                "description": "List of items to run inference on"
              }
            ],
            "output": [
              {
                "type": "Item[]",
                "name": "items",
                "description": "The same input items."
              },
              {
                "type": "Annotation[]",
                "name": "annotations",
                "description": "The predicted annotations."
              }
            ],
            "displayName": "Predict Items",
            "displayIcon": "",
            "description": "Run agentic tool-calling loop"
          },
          {
            "name": "predict_dataset",
            "input": [
              {
                "type": "Dataset",
                "name": "dataset",
                "description": "Dataloop Dataset Entity"
              },
              {
                "type": "Json",
                "name": "filters",
                "description": "Dataloop Filter DQL"
              }
            ],
            "output": [],
            "displayName": "Predict Dataset",
            "displayIcon": "",
            "description": "Run agentic loop on a dataset"
          }
        ]
      }
    ],
    "models": [
      {
        "name": "cloudops-agent",
        "moduleName": "cloudops-agent-module",
        "scope": "project",
        "status": "pre-trained",
        "configuration": {
          "model_name": "openai/gpt-4o",
          "llm_type": "Agent",
          "system_prompt": "You are a cloud operations agent capable of handling multiple cloud operations tasks. Use the available tools to: 1) Analyze cloud spending and resource utilization - identify cost drivers, flag anomalies (>20% day-over-day change), and produce cost optimization reports with recommendations. 2) Monitor resource health - check service health, pod/node metrics, error rates, and autoscaler state to detect degraded services and elevated error rates. 3) Audit compliance - review IAM policies, firewall rules, and network configurations to detect over-privileged roles, open firewall rules, missing encryption, and public bucket exposure. 4) Identify orphan resources - find unused or orphaned cloud resources (VMs, disks, IPs, buckets) with last-used timestamps, owner tags, and cost data. Always produce structured reports with severity levels and concrete recommendations. Do not delete anything - report and recommend only.",
          "tool_set_id": "cloudops",
          "max_turns": 20,
          "max_tokens": 4096,
          "temperature": 0.2,
          "stream": false
        },
        "description": "Unified cloud operations agent for cost optimization, resource health monitoring, compliance auditing, and orphan resource detection."
      }
    ]
  }
}
